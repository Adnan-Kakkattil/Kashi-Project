[
  {
    "id": "ss_tab",
    "type": "tab",
    "label": "Site Safety Monitor",
    "disabled": false,
    "info": "IoT construction site safety dashboard — MQTT from ESP32-S3"
  },
  {
    "id": "ss_broker",
    "type": "mqtt-broker",
    "name": "Local Mosquitto",
    "broker": "localhost",
    "port": "1883",
    "clientid": "node-red-site-safety",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "ss_ui_base",
    "type": "ui_base",
    "theme": {
      "name": "theme-dark",
      "lightTheme": {
        "default": "#0094CE",
        "baseColor": "#0094CE",
        "baseFont": "-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Oxygen-Sans,Ubuntu,Cantarell,Helvetica Neue,sans-serif",
        "edited": true
      },
      "darkTheme": {
        "default": "#097479",
        "baseColor": "#097479",
        "baseFont": "-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Oxygen-Sans,Ubuntu,Cantarell,Helvetica Neue,sans-serif",
        "edited": true
      },
      "angularTheme": {
        "primary": "blue",
        "accents": "teal",
        "warn": "red",
        "background": "grey"
      }
    },
    "site": {
      "name": "Site Safety Monitor",
      "hideToolbar": "false",
      "allowSwipe": "false",
      "lockMenu": "false",
      "allowTempTheme": "true",
      "dateFormat": "DD/MM/YYYY",
      "sizes": {
        "sx": 48,
        "sy": 48,
        "gx": 6,
        "gy": 6,
        "cx": 6,
        "cy": 6,
        "px": 0,
        "py": 0
      }
    }
  },
  {
    "id": "ss_ui_tab",
    "type": "ui_tab",
    "name": "Live Dashboard",
    "icon": "dashboard",
    "order": 1
  },
  {
    "id": "ss_grp_env",
    "type": "ui_group",
    "name": "Environment",
    "tab": "ss_ui_tab",
    "order": 1,
    "disp": true,
    "width": "6",
    "collapse": false
  },
  {
    "id": "ss_grp_gas",
    "type": "ui_group",
    "name": "Gas & Noise",
    "tab": "ss_ui_tab",
    "order": 2,
    "disp": true,
    "width": "6",
    "collapse": false
  },
  {
    "id": "ss_grp_status",
    "type": "ui_group",
    "name": "Status & Alerts",
    "tab": "ss_ui_tab",
    "order": 3,
    "disp": true,
    "width": "6",
    "collapse": false
  },
  {
    "id": "ss_mqtt_tele",
    "type": "mqtt in",
    "z": "ss_tab",
    "name": "Telemetry JSON",
    "topic": "site/safety/telemetry",
    "qos": "0",
    "datatype": "json",
    "broker": "ss_broker",
    "x": 150,
    "y": 100,
    "wires": [["ss_split_tele", "ss_log_events"]]
  },
  {
    "id": "ss_split_tele",
    "type": "function",
    "z": "ss_tab",
    "name": "Split fields",
    "func": "const d = msg.payload || {};\nreturn [\n  { payload: d.temperature },\n  { payload: d.humidity },\n  { payload: d.mq2 },\n  { payload: d.mq7 },\n  { payload: d.noise_db },\n  { payload: d.pm25 },\n  { payload: d.status || 'SAFE' },\n  { payload: d.reason || '' }\n];",
    "outputs": 8,
    "noerr": 0,
    "x": 360,
    "y": 100,
    "wires": [
      ["ss_g_temp"],
      ["ss_g_hum"],
      ["ss_g_mq2"],
      ["ss_g_mq7"],
      ["ss_g_noise"],
      ["ss_g_pm25"],
      ["ss_txt_status", "ss_status_color"],
      ["ss_txt_reason"]
    ]
  },
  {
    "id": "ss_g_temp",
    "type": "ui_gauge",
    "z": "ss_tab",
    "name": "Temperature",
    "group": "ss_grp_env",
    "order": 1,
    "width": 0,
    "height": 0,
    "gtype": "gage",
    "title": "Temperature °C",
    "label": "°C",
    "format": "{{value | number:1}}",
    "min": 0,
    "max": "50",
    "colors": ["#00b500", "#e6e600", "#ca3838"],
    "seg1": "32",
    "seg2": "38",
    "x": 620,
    "y": 40,
    "wires": []
  },
  {
    "id": "ss_g_hum",
    "type": "ui_gauge",
    "z": "ss_tab",
    "name": "Humidity",
    "group": "ss_grp_env",
    "order": 2,
    "width": 0,
    "height": 0,
    "gtype": "gage",
    "title": "Humidity %",
    "label": "%",
    "format": "{{value | number:0}}",
    "min": 0,
    "max": "100",
    "colors": ["#00b500", "#e6e600", "#ca3838"],
    "seg1": "70",
    "seg2": "85",
    "x": 610,
    "y": 80,
    "wires": []
  },
  {
    "id": "ss_g_pm25",
    "type": "ui_gauge",
    "z": "ss_tab",
    "name": "PM2.5",
    "group": "ss_grp_env",
    "order": 3,
    "width": 0,
    "height": 0,
    "gtype": "gage",
    "title": "PM2.5 (optional)",
    "label": "µg/m³",
    "format": "{{value}}",
    "min": 0,
    "max": "300",
    "colors": ["#00b500", "#e6e600", "#ca3838"],
    "seg1": "55",
    "seg2": "150",
    "x": 610,
    "y": 120,
    "wires": []
  },
  {
    "id": "ss_g_mq2",
    "type": "ui_gauge",
    "z": "ss_tab",
    "name": "MQ-2",
    "group": "ss_grp_gas",
    "order": 1,
    "width": 0,
    "height": 0,
    "gtype": "gage",
    "title": "Gas / Smoke (MQ-2)",
    "label": "raw",
    "format": "{{value}}",
    "min": 0,
    "max": "4095",
    "colors": ["#00b500", "#e6e600", "#ca3838"],
    "seg1": "1200",
    "seg2": "2000",
    "x": 620,
    "y": 160,
    "wires": []
  },
  {
    "id": "ss_g_mq7",
    "type": "ui_gauge",
    "z": "ss_tab",
    "name": "MQ-7",
    "group": "ss_grp_gas",
    "order": 2,
    "width": 0,
    "height": 0,
    "gtype": "gage",
    "title": "Carbon Monoxide (MQ-7)",
    "label": "raw",
    "format": "{{value}}",
    "min": 0,
    "max": "4095",
    "colors": ["#00b500", "#e6e600", "#ca3838"],
    "seg1": "800",
    "seg2": "1500",
    "x": 620,
    "y": 200,
    "wires": []
  },
  {
    "id": "ss_g_noise",
    "type": "ui_gauge",
    "z": "ss_tab",
    "name": "Noise",
    "group": "ss_grp_gas",
    "order": 3,
    "width": 0,
    "height": 0,
    "gtype": "gage",
    "title": "Noise dB",
    "label": "dB",
    "format": "{{value | number:0}}",
    "min": 30,
    "max": "120",
    "colors": ["#00b500", "#e6e600", "#ca3838"],
    "seg1": "85",
    "seg2": "95",
    "x": 610,
    "y": 240,
    "wires": []
  },
  {
    "id": "ss_txt_status",
    "type": "ui_text",
    "z": "ss_tab",
    "group": "ss_grp_status",
    "order": 1,
    "width": 0,
    "height": 0,
    "name": "Status",
    "label": "Site status",
    "format": "{{msg.payload}}",
    "layout": "row-spread",
    "x": 610,
    "y": 300,
    "wires": []
  },
  {
    "id": "ss_txt_reason",
    "type": "ui_text",
    "z": "ss_tab",
    "group": "ss_grp_status",
    "order": 2,
    "width": 0,
    "height": 0,
    "name": "Reason",
    "label": "Alert reason",
    "format": "{{msg.payload}}",
    "layout": "row-spread",
    "x": 620,
    "y": 340,
    "wires": []
  },
  {
    "id": "ss_status_color",
    "type": "function",
    "z": "ss_tab",
    "name": "Status colour",
    "func": "const s = String(msg.payload || 'SAFE').toUpperCase();\nmsg.payload = s === 'DANGER' ? 'red' : s === 'CAUTION' ? 'yellow' : 'green';\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 390,
    "y": 380,
    "wires": [["ss_led"]]
  },
  {
    "id": "ss_led",
    "type": "ui_led",
    "z": "ss_tab",
    "name": "Status LED",
    "group": "ss_grp_status",
    "order": 3,
    "width": 0,
    "height": 0,
    "label": "Indicator",
    "allowInput": false,
    "round": true,
    "x": 620,
    "y": 380,
    "wires": []
  },
  {
    "id": "ss_mqtt_alert",
    "type": "mqtt in",
    "z": "ss_tab",
    "name": "Alert topic",
    "topic": "site/safety/alert",
    "qos": "1",
    "datatype": "json",
    "broker": "ss_broker",
    "x": 140,
    "y": 480,
    "wires": [["ss_fmt_tg", "ss_log_events"]]
  },
  {
    "id": "ss_fmt_tg",
    "type": "function",
    "z": "ss_tab",
    "name": "Format + send Telegram",
    "func": "const a = msg.payload || {};\nconst level = a.level || 'WARNING';\nconst reason = a.reason || 'Hazard detected';\nconst text = 'WARNING\\n\\n' + level + '\\n' + reason +\n  '\\n\\nTemp: ' + (a.temperature ?? '-') + ' C' +\n  '\\nCO (MQ-7): ' + (a.mq7 ?? '-') +\n  '\\nGas (MQ-2): ' + (a.mq2 ?? '-') +\n  '\\nNoise: ' + (a.noise_db ?? '-') + ' dB' +\n  '\\n\\nPlease inspect the area immediately.';\n\nconst token = global.get('telegramBotToken');\nconst chatId = global.get('telegramChatId');\nif (!token || String(token).indexOf('YOUR_') === 0 || !chatId || String(chatId).indexOf('YOUR_') === 0) {\n  node.warn('Telegram not configured — dashboard toast only');\n  msg.payload = text;\n  return [null, msg];\n}\n\nmsg.url = 'https://api.telegram.org/bot' + token + '/sendMessage';\nmsg.headers = { 'Content-Type': 'application/json' };\nmsg.payload = { chat_id: chatId, text: text };\nreturn [msg, { payload: text }];",
    "outputs": 2,
    "noerr": 0,
    "x": 390,
    "y": 480,
    "wires": [["ss_tg_http"], ["ss_toast"]]
  },
  {
    "id": "ss_tg_http",
    "type": "http request",
    "z": "ss_tab",
    "name": "Telegram API",
    "method": "POST",
    "ret": "txt",
    "paytoqs": "ignore",
    "url": "",
    "persist": false,
    "authType": "",
    "senderr": false,
    "x": 620,
    "y": 460,
    "wires": [["ss_debug_tg"]]
  },
  {
    "id": "ss_toast",
    "type": "ui_toast",
    "z": "ss_tab",
    "position": "top right",
    "displayTime": "6",
    "highlight": "",
    "sendall": true,
    "outputs": 0,
    "name": "Dashboard toast",
    "x": 640,
    "y": 520,
    "wires": []
  },
  {
    "id": "ss_debug_tg",
    "type": "debug",
    "z": "ss_tab",
    "name": "Telegram response",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "x": 840,
    "y": 460,
    "wires": []
  },
  {
    "id": "ss_log_events",
    "type": "function",
    "z": "ss_tab",
    "name": "Event log row",
    "func": "const p = msg.payload;\nconst now = new Date().toLocaleString();\nif (p && typeof p === 'object') {\n  msg.payload = [{\n    time: now,\n    status: p.status || p.level || '',\n    reason: p.reason || '',\n    temp: p.temperature,\n    mq7: p.mq7,\n    noise: p.noise_db\n  }];\n} else {\n  msg.payload = [{ time: now, status: String(p) }];\n}\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 360,
    "y": 580,
    "wires": [["ss_table"]]
  },
  {
    "id": "ss_table",
    "type": "ui_table",
    "z": "ss_tab",
    "group": "ss_grp_status",
    "name": "Event log",
    "order": 4,
    "width": "6",
    "height": "4",
    "columns": [],
    "outputs": 0,
    "cts": false,
    "x": 610,
    "y": 580,
    "wires": []
  },
  {
    "id": "ss_boot_globals",
    "type": "inject",
    "z": "ss_tab",
    "name": "Load Telegram globals (edit me)",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": true,
    "onceDelay": "0.5",
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 210,
    "y": 660,
    "wires": [["ss_set_globals"]]
  },
  {
    "id": "ss_set_globals",
    "type": "function",
    "z": "ss_tab",
    "name": "Set bot token / chat id",
    "func": "// Replace placeholders, then click Deploy.\nglobal.set('telegramBotToken', 'YOUR_TELEGRAM_BOT_TOKEN');\nglobal.set('telegramChatId', 'YOUR_TELEGRAM_CHAT_ID');\nnode.status({ fill: 'green', shape: 'dot', text: 'globals ready' });\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "x": 480,
    "y": 660,
    "wires": [[]]
  }
]
